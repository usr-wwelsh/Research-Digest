:8080 {
	root * /opt/research-digest

	# Serve index.html as the landing page
	handle / {
		rewrite * /index.html
	}

	# Only serve HTML files and the archive directory
	@allowed {
		path *.html
		path /arxiv_archive/*
	}
	handle @allowed {
		file_server
	}

	# Block everything else
	handle {
		respond 404
	}

	# Cache archived digests but not the main pages (they update weekly)
	header /arxiv_archive/* Cache-Control "public, max-age=604800"
	header /*.html Cache-Control "no-cache, must-revalidate"

	log {
		output file /opt/research-digest/logs/caddy_access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
