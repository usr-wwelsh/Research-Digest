:8080 {
	root * {$RESEARCH_DIGEST_ROOT:/opt/research-digest}

	# Cross-origin isolation, required for onnxruntime-web's threaded WASM
	# backend (models.worker.js) to use SharedArrayBuffer. Without these,
	# onnxruntime-web silently falls back to numThreads=1 no matter which
	# WASM binary is loaded — see fetch_vendor_assets.sh, which already
	# fetches the threaded build. No cross-origin subresources are loaded
	# (relay/* is same-origin reverse-proxied), so this is safe to set
	# globally.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}

	# Only serve HTML files and the archive directory
	@allowed {
		path /
		path *.html
		path /arxiv_archive/*
		path /app/*
		path /vendor/*
		path /manifest.json
		path /sw.js
		path /seed-corpus.json
		path /icons/*
	}
	handle @allowed {
		rewrite / /index.html
		file_server
	}

	# Stateless CORS relay for the client-side PWA (no DB, no auth — see
	# relay.py). Must come before the catch-all below.
	handle /relay/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Block everything else
	handle {
		respond 404
	}

	# Cache archived digests but not the main pages (they update weekly)
	header /arxiv_archive/* Cache-Control "public, max-age=604800"
	header /*.html Cache-Control "no-cache, must-revalidate"
	header /vendor/* Cache-Control "public, max-age=2592000, immutable"
	header /icons/* Cache-Control "public, max-age=2592000"
	header /sw.js Cache-Control "no-cache"
	header /manifest.json Cache-Control "no-cache, must-revalidate"
	header /seed-corpus.json Cache-Control "no-cache, must-revalidate"

	log {
		output file {$RESEARCH_DIGEST_ROOT:/opt/research-digest}/logs/caddy_access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
