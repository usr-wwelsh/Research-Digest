:8080 {
	root * /opt/research-digest

	# Only serve HTML files and the archive directory
	@allowed {
		path /
		path *.html
		path /arxiv_archive/*
		path /app/*
		path /vendor/*
	}
	handle @allowed {
		rewrite / /index.html
		file_server
	}

	# Stateless CORS relay for the client-side PWA (no DB, no auth — see
	# relay.py). Must come before the catch-all below.
	handle /relay/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Block everything else
	handle {
		respond 404
	}

	# Cache archived digests but not the main pages (they update weekly)
	header /arxiv_archive/* Cache-Control "public, max-age=604800"
	header /*.html Cache-Control "no-cache, must-revalidate"
	header /vendor/* Cache-Control "public, max-age=2592000, immutable"

	log {
		output file /opt/research-digest/logs/caddy_access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
