{% extends "base.j2" %}
{% block title %}arXiv Digest Archive{% endblock %}
{% block extra_css %}
    .archive-list { list-style: none; padding: 0; max-width: 900px; margin: 0 auto; }
    .archive-item { background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 10px; padding: 1.2rem 1.5rem; margin-bottom: 1rem; transition: all 0.2s; }
    .archive-item:hover { border-color: var(--accent); transform: translateX(5px); }
    .archive-item a { display: flex; justify-content: space-between; align-items: center; color: var(--text); }
    .date-main { font-size: 1.2rem; font-weight: 700; color: var(--link); }
    .date-day { font-size: 0.9rem; color: var(--muted); }
    .arrow { font-size: 1.5rem; color: var(--accent); }
    .no-reports { text-align: center; color: var(--muted); padding: 3rem; }
{% endblock %}
{% block body %}
  <header style="text-align:center; margin-bottom:2.5rem;">
    <h1>🗄 Digest Archive</h1>
    <div class="meta">{{ entries|length }} snapshot{{ "" if entries|length == 1 else "s" }} • updated {{ generated }}</div>
  </header>
  {% if entries %}
  <ul class="archive-list">
    {% for e in entries %}
    <li class="archive-item">
      <a href="arxiv_archive/{{ e.filename }}">
        <div><div class="date-main">{{ e.date }}</div><div class="date-day">{{ e.day }}</div></div>
        <div class="arrow">→</div>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <div class="no-reports">No archived snapshots yet.</div>
  {% endif %}
{% endblock %}
