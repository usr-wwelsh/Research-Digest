<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}Research Digest{% endblock %}</title>
  <style>
    * { box-sizing: border-box; }
    :root {
      --bg: #0f0f0f; --text: #e8e8e8; --muted: #999; --border: #2a2a2a;
      --card-bg: #1a1a1a; --link: #6ba3ff; --accent: #ff6b6b;
      --layman-bg: #1f2937; --layman-border: #60a5fa;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.5; color: var(--text); background: var(--bg); margin: 0; padding: 1rem;
    }
    a { color: var(--link); text-decoration: none; }
    a:hover { color: var(--accent); }
    .container { max-width: 1600px; margin: 0 auto; }
    .topbar { display: flex; justify-content: space-between; align-items: center;
      padding: 0.6rem 0; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
    .topbar .brand { font-weight: 900; font-size: 1.1rem; color: var(--text); }
    .topbar nav a { margin-left: 1.2rem; font-weight: 600; font-size: 0.9rem; }
    h1 { font-weight: 900; font-size: 2.5rem; margin: 0;
      background: linear-gradient(135deg, var(--accent), #ffa94d);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .meta { color: var(--muted); font-size: 0.95rem; margin-top: 0.5rem; }
    .searchbar { width: 100%; max-width: 480px; margin: 0 auto 2rem; display: block;
      padding: 0.7rem 1rem; border-radius: 10px; border: 1px solid var(--border);
      background: var(--card-bg); color: var(--text); font-size: 0.95rem; }
    .interest-section { margin-bottom: 3rem; }
    .interest-header { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.2rem;
      padding: 0.8rem 1rem; background: var(--card-bg); border-radius: 12px;
      border-left: 4px solid var(--accent); }
    .interest-title { font-size: 1.3rem; margin: 0; font-weight: 700; }
    .papers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
      gap: 1.2rem; }
    .paper { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px;
      padding: 1.2rem; display: flex; flex-direction: column; height: 100%;
      transition: border-color 0.2s, transform 0.2s; }
    .paper:hover { border-color: var(--accent); transform: translateY(-2px); }
    .difficulty-badge { padding: 0.3rem 0.7rem; border-radius: 20px; font-size: 0.7rem;
      font-weight: 700; align-self: flex-start; margin-bottom: 0.6rem; }
    .d-applied { background: #14331c; color: #51cf66; }
    .d-advanced { background: #332d12; color: #ffd43b; }
    .d-theory { background: #331417; color: #ff6b6b; }
    .paper h3 { font-size: 1.05rem; margin: 0 0 0.6rem; font-weight: 700; line-height: 1.4; }
    .layman-box { background: var(--layman-bg); border-left: 3px solid var(--layman-border);
      padding: 0.7rem 0.9rem; margin-bottom: 0.8rem; border-radius: 6px; font-size: 0.88rem;
      color: #94a3b8; font-style: italic; }
    .summary { color: var(--muted); margin-bottom: 0.8rem; font-size: 0.88rem;
      line-height: 1.6; flex-grow: 1; }
    .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.6rem; }
    .tag { background: #20262e; color: #9bb4d4; padding: 0.2rem 0.55rem; border-radius: 12px;
      font-size: 0.72rem; }
    .related { font-size: 0.78rem; color: var(--muted); margin-bottom: 0.6rem; }
    .related a { font-size: 0.78rem; }
    .paper-footer { display: flex; justify-content: space-between; align-items: center;
      padding-top: 0.7rem; border-top: 1px solid var(--border); margin-top: auto; }
    .category-tag { background: #1e3a5f; color: #60a5fa; padding: 0.25rem 0.65rem;
      border-radius: 15px; font-size: 0.75rem; font-weight: 600; }
    .date { color: var(--muted); font-size: 0.75rem; }
    .links { display: flex; gap: 1rem; margin-top: 0.7rem; }
    .links a { font-size: 0.85rem; font-weight: 600; }
    .footer { text-align: center; margin-top: 4rem; padding: 2rem; color: var(--muted);
      font-size: 0.85rem; border-top: 1px solid var(--border); }
    .footer a { font-weight: 600; }
    @media (max-width: 768px) { .papers-grid { grid-template-columns: 1fr; } h1 { font-size: 2rem; } }
    {% block extra_css %}{% endblock %}
  </style>
</head>
<body>
  <div class="container">
    <div class="topbar">
      <a class="brand" href="index.html">📚 Research Digest</a>
      <nav>
        <a href="latest.html">Latest</a>
        <a href="archive.html">Archive</a>
        <a href="feed.html">Feed</a>
      </nav>
    </div>

    {% block body %}{% endblock %}

    <div class="footer">
      A live instance of <a href="{{ projects.research_digest }}">Research Digest</a>,
      with summaries generated locally by <a href="{{ projects.turbolab }}">turbolab</a>.<br>
      No API keys · no cloud · self-hosted ·
      <a href="{{ projects.portfolio }}">wwel.sh</a> · &copy; {{ year }}
    </div>
  </div>
</body>
</html>
