<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>Research Feed • {{ generated }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg:#000; --text:#fff; --muted:#a0a0a0; --card-bg:#1a1a1a; --border:#2a2a2a;
      --accent:#ff6b6b; --layman-bg:#1f2937; --layman-border:#60a5fa; }
    body { font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background:var(--bg); color:var(--text); overflow-x:hidden; }
    .bar { position:fixed; top:0; left:0; right:0; z-index:200; display:flex; gap:0.6rem;
      align-items:center; padding:0.6rem 1rem; background:rgba(0,0,0,0.95);
      backdrop-filter:blur(10px); border-bottom:1px solid var(--border); }
    .bar a { color:var(--muted); text-decoration:none; font-weight:700; font-size:1.2rem; }
    .bar input { flex:1; padding:0.5rem 0.9rem; border-radius:18px; border:1px solid var(--border);
      background:var(--card-bg); color:var(--text); font-size:0.9rem; }
    #feed { height:100vh; overflow-y:scroll; scroll-snap-type:y mandatory; padding-top:56px; }
    .card { min-height:100vh; scroll-snap-align:start; display:flex; flex-direction:column;
      justify-content:center; padding:2rem 1.5rem; border-bottom:1px solid var(--border); }
    .badge { display:inline-block; background:var(--accent); color:#fff; padding:0.35rem 0.9rem;
      border-radius:20px; font-size:0.7rem; font-weight:700; text-transform:uppercase;
      letter-spacing:0.5px; margin-bottom:0.6rem; align-self:flex-start; }
    .diff { font-size:0.75rem; color:var(--muted); margin-bottom:1rem; }
    .title { font-size:1.5rem; font-weight:800; line-height:1.3; margin-bottom:1rem; }
    .layman { background:var(--layman-bg); border-left:3px solid var(--layman-border);
      padding:1rem; margin-bottom:1rem; border-radius:8px; font-size:0.95rem; color:#94a3b8;
      font-style:italic; }
    .summary { color:var(--muted); font-size:0.95rem; line-height:1.6; margin-bottom:1rem; }
    .tags { display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:1.2rem; }
    .tag { background:#20262e; color:#9bb4d4; padding:0.2rem 0.6rem; border-radius:12px; font-size:0.72rem; }
    .links { display:flex; gap:1.5rem; }
    .links a { color:#6ba3ff; text-decoration:none; font-weight:600; font-size:0.9rem; }
    .empty { padding:6rem 2rem; text-align:center; color:var(--muted); }
  </style>
</head>
<body>
  <div class="bar">
    <a href="index.html" title="Home">‹</a>
    <input id="q" type="search" placeholder="Filter feed…" autocomplete="off" />
  </div>
  <div id="feed"></div>
  <script>
    const papers = {{ papers | tojson }};
    const DIFF = { "Applied": "🟢 Applied", "Advanced": "🟡 Advanced", "Theory-Heavy": "🔴 Theory-Heavy" };
    const feed = document.getElementById('feed');
    const esc = s => (s || "").replace(/[&<>"]/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c]));

    function render(list) {
      if (!list.length) { feed.innerHTML = '<div class="empty">No matching papers.</div>'; return; }
      feed.innerHTML = list.map(p => `
        <div class="card">
          <span class="badge">${esc(p.interest)}</span>
          ${p.difficulty ? `<div class="diff">${DIFF[p.difficulty] || esc(p.difficulty)}</div>` : ""}
          <h1 class="title">${esc(p.title)}</h1>
          ${p.layman ? `<div class="layman">💡 ${esc(p.layman)}</div>` : ""}
          <div class="summary">${esc(p.summary)}</div>
          ${p.tags && p.tags.length ? `<div class="tags">${p.tags.map(t => `<span class="tag">${esc(t)}</span>`).join("")}</div>` : ""}
          <div class="links">
            <a href="${esc(p.abs_url)}" target="_blank" rel="noopener">Abstract ↗</a>
            <a href="${esc(p.pdf_url)}" target="_blank" rel="noopener">PDF ↗</a>
          </div>
        </div>`).join("");
    }

    const q = document.getElementById('q');
    q.addEventListener('input', () => {
      const t = q.value.toLowerCase().trim();
      render(!t ? papers : papers.filter(p =>
        (p.title + " " + p.summary + " " + (p.tags || []).join(" ")).toLowerCase().includes(t)));
      feed.scrollTop = 0;
    });
    render(papers);
  </script>
</body>
</html>
