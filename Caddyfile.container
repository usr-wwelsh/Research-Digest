{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}

	@allowed {
		path /
		path *.html
		path /app/*
		path /vendor/*
		path /manifest.json
		path /sw.js
		path /seed-corpus.json
		path /icons/*
	}
	handle @allowed {
		rewrite / /index.html
		file_server
	}

	handle {
		respond 404
	}

	header /*.html Cache-Control "no-cache, must-revalidate"
	header /vendor/* Cache-Control "public, max-age=2592000, immutable"
	header /icons/* Cache-Control "public, max-age=2592000"
	header /sw.js Cache-Control "no-cache"
	header /manifest.json Cache-Control "no-cache, must-revalidate"
	header /seed-corpus.json Cache-Control "no-cache, must-revalidate"

	log {
		output stdout
	}
}
